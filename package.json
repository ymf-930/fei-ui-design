{
  "name": "fei-ui-design",
  "version": "0.0.3",
  "description": "面向 Vue 3 的开源 UI 组件库，提供企业级中后台组件的开箱即用体验",
  "keywords": [
    "fei-ui-design",
    "f-ui-one",
    "ui",
    "vue",
    "vue3",
    "components",
    "component-library"
  ],
  "author": "ymf",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.styl",
    "./dist/**"
  ],
  "homepage": "https://ymf-930.gitee.io/fei-ui-design/",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/ymf-930/fei-ui-design.git"
  },
  "bugs": {
    "url": "https://gitee.com/ymf-930/fei-ui-design/issues"
  },
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "types": "./es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./es/*": [
      "./es/*/index.js",
      "./es/*"
    ],
    "./lib/*": [
      "./lib/*/index.js",
      "./lib/*"
    ],
    "./dist/*": "./dist/*",
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "es",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "es5-ext"
    ]
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build:package": "run-s clean gen-version build:lib build:style",
    "build:site": "vitepress build docs",
    "clean": "rimraf dist es lib",
    "build:lib": "vite build && node build/gen-pkg-type.cjs",
    "build:style": "gulp -f build/build-style.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css}\"",
    "gen-version": "node build/gen-version.cjs",
    "docs:check-api": "node build/check-docs-api.cjs",
    "docs:check-links": "node build/check-docs-links.cjs",
    "docs:check-demo": "node build/check-docs-demo.cjs",
    "docs:check-style": "node build/check-docs-style.cjs",
    "docs:check-tags": "node build/check-docs-tags.cjs",
    "docs:check-site": "node build/check-site-links.cjs",
    "docs:check-contrast": "node build/check-docs-contrast.cjs",
    "docs:check-placeholders": "node build/check-docs-placeholders.cjs",
    "docs:check": "run-s docs:check-api docs:check-links docs:check-demo docs:check-style docs:check-tags",
    "verify:dist": "node build/verify-dist.cjs",
    "smoke": "node build/smoke-consumer.cjs",
    "verify": "run-s verify:dist smoke",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "prepublishOnly": "run-s build:package verify:dist"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "async-validator": "^4.2.5",
    "color": "^4.2.3",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "resize-observer-polyfill": "^1.5.1",
    "sortablejs": "^1.15.7"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/gulp": "^4.0.18",
    "@types/gulp-postcss": "^8.0.6",
    "@types/node": "^20.19.43",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitepress-demo-preview/component": "^2.6.2",
    "@vitepress-demo-preview/plugin": "^1.4.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "boxicons": "^2.1.4",
    "esbuild": "^0.19.12",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-postcss": "^10.0.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.30",
    "postcss-color-mix": "^1.1.0",
    "postcss-each": "^1.1.0",
    "postcss-each-variables": "^0.3.0",
    "postcss-for": "^2.1.1",
    "postcss-functions": "^4.0.2",
    "postcss-import": "^17.0.1",
    "postcss-nested": "^9.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "stylus": "^0.64.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
