{
  "name": "fei-ui-design",
  "version": "0.0.2",
  "description": "面向 Vue 3 的开源 UI 组件库，提供企业级中后台组件的开箱即用体验",
  "keywords": [
    "fei-ui-design",
    "f-ui-one",
    "ui",
    "vue",
    "vue3",
    "components",
    "component-library"
  ],
  "author": "ymf",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://ymf-930.gitee.io/fei-ui-design/",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/ymf-930/fei-ui-design.git"
  },
  "bugs": {
    "url": "https://gitee.com/ymf-930/fei-ui-design/issues"
  },
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "types": "./es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./es/*": [
      "./es/*/index.js",
      "./es/*"
    ],
    "./lib/*": [
      "./lib/*/index.js",
      "./lib/*"
    ],
    "./dist/*": "./dist/*",
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "*.css",
    "*.scss",
    "./dist/**"
  ],
  "files": [
    "dist",
    "es",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "es5-ext"
    ]
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build:package": "run-s clean gen-version build:lib build:style",
    "build:site": "vitepress build docs",
    "preview": "vite preview",
    "clean": "rimraf dist es lib",
    "build:lib": "vite build && node build/gen-pkg-type.cjs",
    "build:style": "gulp --require @esbuild-kit/cjs-loader -f build/build-style.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css}\"",
    "gen-version": "node build/gen-version.cjs",
    "docs:check-api": "node build/check-docs-api.cjs",
    "docs:check-links": "node build/check-docs-links.cjs",
    "docs:check-demo": "node build/check-docs-demo.cjs",
    "docs:check-style": "node build/check-docs-style.cjs",
    "docs:check-tags": "node build/check-docs-tags.cjs",
    "docs:check-site": "node build/check-site-links.cjs",
    "docs:check-contrast": "node build/check-docs-contrast.cjs",
    "docs:check": "run-s docs:check-api docs:check-links docs:check-demo docs:check-style",
    "verify:dist": "node build/verify-dist.cjs",
    "smoke": "node build/smoke-consumer.cjs",
    "verify": "run-s verify:dist smoke",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "prepublishOnly": "run-s build:package verify:dist"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "async-validator": "^4.2.5",
    "color": "^4.2.3",
    "dayjs": "^1.11.10",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "resize-observer-polyfill": "^1.5.1",
    "sortablejs": "^1.15.1"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@esbuild-kit/cjs-loader": "^2.4.4",
    "@rushstack/eslint-patch": "^1.6.1",
    "@types/gulp": "^4.0.17",
    "@types/gulp-autoprefixer": "^0.0.37",
    "@types/gulp-postcss": "^8.0.6",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "@vitejs/plugin-vue": "^5.0.2",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitepress-demo-preview/component": "^2.3.2",
    "@vitepress-demo-preview/plugin": "^1.2.2",
    "@vitest/coverage-v8": "^1.1.3",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/runtime-core": "^3.4.5",
    "@vue/shared": "^3.4.5",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.16",
    "boxicons": "^2.1.4",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-with-typescript": "^43.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.19.2",
    "fs-extra": "^11.2.0",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^9.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-postcss": "^9.0.1",
    "jsdom": "^23.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.33",
    "postcss-color-mix": "^1.1.0",
    "postcss-each": "^1.1.0",
    "postcss-each-variables": "^0.3.0",
    "postcss-for": "^2.1.1",
    "postcss-functions": "^4.0.2",
    "postcss-import": "^16.0.0",
    "postcss-nested": "^6.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "stylus": "^0.62.0",
    "sucrase": "^3.35.0",
    "typescript": "~5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-dts": "^3.7.0",
    "vitepress": "1.0.0-rc.35",
    "vitest": "^1.1.3",
    "vue": "^3.4.5",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^1.8.27"
  }
}
