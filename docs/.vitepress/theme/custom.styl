a
  font-weight 500
  color getVar(theme-color) !important
  text-decoration none

p a code
  font-weight 400
  color getVar(theme-color)

// ── 正文排版 ────────────────────────────────────────────────────────────────
// 标题阶梯、段落、列表、代码块、表格、引用的**元素级规则**已统一收敛到
// styles/doc-typography.styl：那里只作用于 `.vp-doc`，选择器优先级也足以压过
// VitePress 默认主题与组件库 reset，因此这里不再重复定义，避免两处规则互相抵消。
//
// 顺带清掉一批「看着生效、其实被浏览器丢弃」的声明：
//   h2 { border-bottom 1px solid $borderColor } / hr { border-top 1px solid $borderColor }
//     —— `$borderColor` 在本项目里**从未定义**（VitePress 1.x 已移除这批 Stylus 变量），
//         Stylus 不报错、原样输出，浏览器按非法值丢弃。所以 h2 从来没有下划线，
//        hr 也从来没有线（只剩 `border 0`）。
//   h1/h2/h3 { font-size 2.2rem / 1.5rem / 1.35rem }
//     —— 与 VitePress 的 `.vp-doc h1~h3` 冲突，且 h2 1.5rem 与 h3 1.35rem 只差 1.11 倍，
//        层级挤在一起。新阶梯见 doc-typography.styl。
//   h1~h6 { line-height 1.25 !important }
//     —— `!important` 会顶掉新的行高 token，改为普通声明。
//   a.header-anchor { float left; margin-left -0.87em }
//     —— 正文改为不再内缩后，该负偏移会落到卡片 overflow 裁剪区之外，
//        锚点 hover 时会整体消失；新写法（跟在标题文字之后）见 doc-typography.styl。

strong
  font-weight 600

h1, h2, h3, h4, h5, h6
  font-weight 600
  line-height 1.25

kbd
  background #eee
  border solid 0.15rem #ddd
  border-bottom solid 0.25rem #ddd
  border-radius 0.15rem
  padding 0 0.15em

.theme-container
  &.sidebar-open
    .sidebar-mask
      display: block

  &.no-navbar
    .content:not(.custom) > h1, h2, h3, h4, h5, h6
      margin-top 1.5rem
      padding-top 0

    .sidebar
      top 0

.no-sidebar
  .navbar
    box-shadow: 0px 0px 0px 0px rgba(0, 0, 0, .1)

  .navbar.fixed
    box-shadow: 0px 0px 15px 0px rgba(0, 0, 0, .04)





@media (min-width: 1000px)
  .theme-container.no-sidebar
    .sidebar
      display none

    .page
      padding-left 0


