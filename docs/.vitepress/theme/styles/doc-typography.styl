// ============================================================================
// 文档正文排版层（Documentation Typography）—— 唯一权威来源
// ----------------------------------------------------------------------------
// 范围：只作用于 `.vp-doc`（Markdown 正文）。首页 `.home`、导航、页脚、
//       侧边栏属于站点外壳，不受影响。
// 目标：字号成阶梯、间距成节奏、正文/列表/代码/表格共用同一条左右基准线。
//
// 四条硬约束（改之前先读）
//   1. 数值只能来自下方 token，规则里不写裸数字
//   2. 卡片内内容**不再**额外左右内缩 —— 与外层导语段落共用同一条内容边，
//      这是「标题 / 正文 / 列表 / 表格 / 代码块左边缘对齐」的实现方式
//   3. 凡「只想改文档、不该碰组件本体」的规则，都要排除 demo 区
//      （`:not(.example *)`）—— 那里渲染的是被演示的组件实体
//      （`<f-table>` 是 `<table>`、面包屑/下拉菜单/分割线里是真实的 `<a>`）
//   4. 需要压过站点外壳规则时用 `!important`，但必须同时排除 demo 区
//
// 层级：由 theme/index.css 顶部 `@import` 引入。index.css 又在 index.ts 里排在
//       `vitepress/theme`（默认主题样式）**之后**，所以同优先级的规则也是本层胜出
//       —— 例如 VitePress 默认的 `.vp-doc h2{font-size:24px}` 会被本层覆盖。
//       选择器一律带 `.vp-doc`，用来压过组件库的裸元素 reset（`p` / `ul` / `table`…）。
// ============================================================================

// ── 设计 token ──────────────────────────────────────────────────────────────
:root {
  // 字体族
  //   必须自带 CJK 族名：只列拉丁族名时，中文由浏览器按「系统 UI 字体」兜底，
  //   同一台机器上不同区域可能选出不同字面（实测外壳与正文的中文就不是一款），
  //   中文观感无法统一。族名顺序 = 拉丁交给 Poppins，中文依次交给 PingFang /
  //   微软雅黑（Windows 与 macOS 各取其一），最后才落到通用族。
  --fd-font-sans: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  --fd-font-mono: source-code-pro, Menlo, Monaco, Consolas, "Courier New", monospace;

  // 字号阶梯（≈1.2 模数，正文 15px）
  //   30(页面主标题, 见 components/Page.vue) / 28 / 24 / 20 / 17 / 16 / 15 —— 级差
  //   1.07 / 1.17 / 1.20 / 1.18 / 1.06。每一级都显式声明：VitePress 默认主题只写了
  //   h1~h3，h4~h6 会退回浏览器默认的 1.17em / .83em / .67em，其中 h6 只有 ~10px，
  //   比正文还小。
  //   全部取整数像素 —— 半像素（13.5 / 12.5）在 100% 缩放下由浏览器做亚像素舍入，
  //   不同元素舍入方向可能不同，行高与基线会轻微抖动。14 / 12 也与组件库自己的
  //   --fei-font-size-default / --fei-font-size-small 两档对齐。
  --fd-fs-h1: 28px;
  --fd-fs-h2: 24px;
  --fd-fs-h3: 20px;
  --fd-fs-h4: 17px;
  --fd-fs-h5: 16px;
  --fd-fs-h6: 15px;
  --fd-fs-body: 15px;
  --fd-fs-sm: 14px;
  --fd-fs-xs: 12px;
  --fd-fs-code: 13px;

  // 行高
  --fd-lh-heading: 1.4;
  --fd-lh-body: 1.75;
  --fd-lh-code: 1.65;

  // 间距节奏（8pt 栅格）
  --fd-sp-1: 4px;
  --fd-sp-2: 8px;
  --fd-sp-3: 12px;
  --fd-sp-4: 16px;
  --fd-sp-5: 24px;
  --fd-sp-6: 32px;
  --fd-sp-7: 48px;

  // 描边与圆角
  --fd-border: #e6eaf0;
  --fd-radius-sm: 6px;
  --fd-radius-md: 10px;
  --fd-radius-lg: 16px;

  // 文章色 / 链接色
  //   链接与锚点**不能**复用 --fei-color-primary：那是组件库主色（#1a5cff），
  //   在暗色底上只有 3.36:1。文档层自己持有这一对，才能按主题分别取色。
  --fd-link: #1a5cff;
  --fd-link-hover: #1753e6;

  // 文字色：两档即可。两者在页面底色 #f4f7f8 上分别约 10:1 / 5.1:1
  --fd-text-1: #2c3e50;
  --fd-text-2: #5a6b7d;

  // 文档 API 表格
  --fd-th-bg: #f5f7fa;
  --fd-table-bg: #fff;
  // 表格正文色独立成 token，**不要**复用 --vs-theme-code：
  // 那个值在暗色下会被改成近黑（#141417），现在压在白色表格底上没问题，
  // 一旦表格底跟着变暗就会变成黑底黑字。
  --fd-table-text: #3f3d56;
  --fd-tr-stripe: #fafbfd;
  --fd-tr-hover: #f0f5ff;

  // 引用块底色。**不要**复用 --fei-color-primary-light6：那套 token 同时被
  // `.example` 演示区里的组件实体使用，暗色下直接覆盖它会连带改掉演示卡片的配色。
  --fd-quote-bg: #f4f7ff;
}

// ── 暗色主题 ────────────────────────────────────────────────────────────────
// 站点外壳（导航 / 侧边栏 / 页头）跟随 --vs-theme-* 变暗，但本层的 --fd-* 是
// 自建 token，必须自己声明暗色分支 —— 否则外壳变黑、正文仍是 #2c3e50，
// 实测对比度只剩 1.60:1（行内码 1.55:1），用户会以为「文档坏了」。
//
// 选择器必须是 `body[vs-theme="dark"]`：applyTheme()（components/Config.vue）
// 把该属性写在 <body> 上（不是 <html>）。**不要**写成 `.darken` ——
// 那个类只负责消息组件里 .has-darken / .not-darken 的显隐。
// 选择器同时接受 `html[vs-theme="dark"]` 与 `body[vs-theme="dark"]`：
// applyTheme()（components/Config.vue）会把属性写到**两层**上 —— <html> 那份是给
// 画布色与 color-scheme 用的，<body> 那份是给外壳 token 用的。只认其中一层，
// 以后有人删掉任一侧，这一整层排版就会静默退回浅色值。
html[vs-theme="dark"],
body[vs-theme="dark"] {
  --fd-text-1: #e6e8eb;      // on #18191c → 14.3:1
  --fd-text-2: #a3aab4;      // → 7.5:1
  --fd-link: #4d8dff;        // → 5.50:1
  --fd-link-hover: #7aa9ff;  // → 8.4:1
  --fd-table-text: #c9ced6;  // → 11.1:1
  --fd-border: #33363c;
  --fd-th-bg: #23262b;
  --fd-table-bg: #191a1e;
  --fd-tr-stripe: #1c1e22;
  --fd-tr-hover: #1f2735;
  --fd-quote-bg: rgba(77, 141, 255, 0.12);  // on #18191c ≈ #1e2737
}

// ── 正文根 ─────────────────────────────────────────────────────────────────
.vp-doc {
  font-family: var(--fd-font-sans);
  font-size: var(--fd-fs-body);
  line-height: var(--fd-lh-body);
  color: var(--fd-text-1);
  // 供 h2/h3 的 hover 高亮、以及锚点定位复用
  --fd-anchor-offset: 96px;
}

// ── 标题阶梯 ───────────────────────────────────────────────────────────────
.vp-doc h1,
.vp-doc h2,
.vp-doc h3,
.vp-doc h4,
.vp-doc h5,
.vp-doc h6 {
  position: relative;
  margin: 0;
  padding: 0;
  border: 0;
  font-weight: 600;
  line-height: var(--fd-lh-heading);
  color: var(--fd-text-1);
  // 站内锚点跳转时，标题不会被吸顶的导航栏/页头盖住
  scroll-margin-top: var(--fd-anchor-offset);
}

.vp-doc h1 {
  font-size: var(--fd-fs-h1);
  letter-spacing: -0.02em;
  margin: var(--fd-sp-6) 0 var(--fd-sp-4);
}

.vp-doc h2 {
  font-size: var(--fd-fs-h2);
  letter-spacing: -0.01em;
  margin: var(--fd-sp-7) 0 var(--fd-sp-3);
}

.vp-doc h3 {
  font-size: var(--fd-fs-h3);
  margin: var(--fd-sp-6) 0 var(--fd-sp-2);
}

.vp-doc h4 {
  font-size: var(--fd-fs-h4);
  margin: var(--fd-sp-5) 0 var(--fd-sp-2);
}

.vp-doc h5 {
  font-size: var(--fd-fs-h5);
  margin: var(--fd-sp-4) 0 var(--fd-sp-2);
  color: var(--fd-text-1);
}

.vp-doc h6 {
  font-size: var(--fd-fs-h6);
  margin: var(--fd-sp-4) 0 var(--fd-sp-2);
  color: var(--fd-text-2);
  letter-spacing: 0.01em;
}

// 首个/末个元素不产生多余外边距，保证「区块首行」与容器边缘严格齐平
.vp-doc > div > div > *:first-child,
.vp-doc .text > *:first-child {
  margin-top: 0;
}

.vp-doc > div > div > *:last-child,
.vp-doc .text > *:last-child {
  margin-bottom: 0;
}

// ── 锚点 ───────────────────────────────────────────────────────────────────
// 原实现是 `float: left; margin-left: -0.87em`：把锚点放到标题左侧的负偏移里。
// 一旦标题不再内缩（本次对齐改造），该负偏移就落到卡片 overflow 裁剪区之外，
// 锚点会在 hover 时彻底消失；且 `float` 会让标题首行产生位移风险。
// 改为跟在标题文字之后的常规行内元素：不位移、不会被裁剪。
.vp-doc a.header-anchor,
.vp-doc .header-anchor {
  position: static;
  float: none;
  display: inline-block;
  margin: 0 0 0 var(--fd-sp-2);
  padding: 0;
  // 0.7em：h2 提到 24px 之后，0.8em 会算出 19.2px，锚点比小节标题还抢眼
  font-size: 0.7em;
  font-weight: 500;
  color: var(--fd-link);
  opacity: 0;
  user-select: none;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.vp-doc h1:hover .header-anchor,
.vp-doc h2:hover .header-anchor,
.vp-doc h3:hover .header-anchor,
.vp-doc h4:hover .header-anchor,
.vp-doc h5:hover .header-anchor,
.vp-doc h6:hover .header-anchor,
.vp-doc .header-anchor:focus {
  opacity: 1;
}

// ── 正文流 ─────────────────────────────────────────────────────────────────
.vp-doc p {
  margin: var(--fd-sp-4) 0;
  font-size: var(--fd-fs-body);
  line-height: var(--fd-lh-body);
}

.vp-doc strong {
  font-weight: 600;
  color: var(--fd-text-1);
}

.vp-doc a {
  font-weight: 500;
  text-decoration: none;
  transition: color 0.2s ease;
}

// 链接颜色必须单独成条，且**必须带 `!important`**：
// custom.styl 里有一条站点级的 `a { color: var(--vs-theme-color) !important }`
// （外壳所有 <a> 共用），会把正文链接刷成与正文同色（#2c3e50），
// 段落里的链接于是几乎看不出来 —— 只有 `!important` + 更高优先级能压过去。
// `:not(.example *)` 与表格同理：demo 区里真实存在 <a>（面包屑 / 分割线 /
// 下拉菜单 / 抽屉 / 菜单 / 弹出信息等示例），文档链接色不能刷到组件本体上。
// 用 --fd-link 而不是 --fei-color-primary：后者是组件库主色，暗色下只有 3.36:1。
.vp-doc a:not(.example *) {
  color: var(--fd-link) !important;
}

.vp-doc a:not(.example *):hover {
  color: var(--fd-link-hover) !important;
}

.vp-doc hr {
  margin: var(--fd-sp-6) 0;
  border: 0;
  border-top: 1px solid var(--fd-border);
}

.vp-doc img {
  max-width: 100%;
}

// 独立成段的图片（徽章之类行内图片不受影响）
.vp-doc .text > img,
.vp-doc p > img:only-child {
  display: block;
  margin: var(--fd-sp-4) auto;
  border-radius: var(--fd-radius-md);
}

// ── 列表 ───────────────────────────────────────────────────────────────────
.vp-doc ul,
.vp-doc ol {
  margin: var(--fd-sp-4) 0;
  padding-left: 1.6em;
}

.vp-doc ul {
  list-style: disc;
}

.vp-doc ol {
  list-style: decimal;
}

.vp-doc li {
  font-size: var(--fd-fs-body);
  line-height: var(--fd-lh-body);
}

.vp-doc li + li {
  margin-top: var(--fd-sp-1);
}

.vp-doc li > ul,
.vp-doc li > ol {
  margin: var(--fd-sp-1) 0 0;
}

// 列表项里的多段文字不应把行距撑开
.vp-doc li > p {
  margin: var(--fd-sp-1) 0;
}

// ── 引用 ───────────────────────────────────────────────────────────────────
// 原实现正文用 #999（在 #f4f7f8 上约 2.6:1，低于 WCAG AA 的 4.5:1）。
// 底色走 --fd-quote-bg 而非 --fei-color-primary-light6：后者是组件库 token，
// 只有浅色一套，且 .example 演示区也在用它。
.vp-doc blockquote {
  margin: var(--fd-sp-4) 0;
  padding: var(--fd-sp-3) var(--fd-sp-4);
  border-left: 3px solid var(--fei-color-primary-light2);
  border-radius: 0 var(--fd-radius-sm) var(--fd-radius-sm) 0;
  background: var(--fd-quote-bg);
  color: var(--fd-text-2);
  font-size: var(--fd-fs-body);
}

.vp-doc blockquote > p {
  margin: var(--fd-sp-2) 0;
  font-size: var(--fd-fs-body);
  line-height: var(--fd-lh-body);
  color: inherit;
}

.vp-doc blockquote > p:first-child {
  margin-top: 0;
}

.vp-doc blockquote > p:last-child {
  margin-bottom: 0;
}

// ── 行内代码 ───────────────────────────────────────────────────────────────
.vp-doc :not(pre) > code {
  padding: 2px 6px;
  border-radius: var(--fd-radius-sm);
  background-color: var(--vs-theme-bg2);
  color: var(--fd-text-1);
  font-family: var(--fd-font-mono);
  // 相对正文缩放，随字号阶梯同步；不要再写死 em 值
  font-size: 0.9em;
  box-shadow: none;
}

.vp-doc h1 > code,
.vp-doc h2 > code,
.vp-doc h3 > code,
.vp-doc h4 > code,
.vp-doc h5 > code,
.vp-doc h6 > code {
  font-size: 0.88em;
}

// ── 代码块 ─────────────────────────────────────────────────────────────────
// 底色由 custom.styl 的 --vs-theme-code2 提供，语法着色主题在 .vitepress/config.js，
// 两者必须配套 —— 见 build/check-docs-contrast.cjs。
.vp-doc div[class*='language-'] {
  position: relative;
  margin: var(--fd-sp-4) 0;
  border-radius: var(--fd-radius-md);
  background-color: transparent;
}

.vp-doc [class*='language-'] pre {
  margin: 0;
  padding: 0;
  background: var(--vs-theme-code2);
  border-radius: inherit;
  overflow-x: auto;
}

.vp-doc [class*='language-'] pre code {
  display: block;
  padding: var(--fd-sp-4) var(--fd-sp-5);
  font-family: var(--fd-font-mono);
  font-size: var(--fd-fs-code);
  line-height: var(--fd-lh-code);
  background: transparent;
}

// 语言角标与复制按钮
.vp-doc [class*='language-'] > span.lang {
  top: var(--fd-sp-3);
  right: var(--fd-sp-4);
  font-size: var(--fd-fs-xs);
  // 原为 0.4 → 在 #363449 上只有 3.33:1。它是装饰件，不强制 AA，
  // 但既然代码 token 已由 build/check-docs-contrast.cjs 卡到 AA，这里一并对齐。
  color: rgba(255, 255, 255, 0.55);
}

.vp-doc [class*='language-'] > button.copy {
  display: none;
}

// 卡片里的代码面板（codex）自带容器与圆角，内层代码块必须贴平，
// 否则会给深色面板内部再套一层圆角与间距。
.vp-doc .con-code div[class*='language-'],
.vp-doc .con-code div[class*='language-'] pre,
.vp-doc .con-code div[class*='language-'] pre code {
  margin: 0;
  border-radius: 0;
}

.vp-doc .con-code div[class*='language-'] pre code {
  padding: var(--fd-sp-4) var(--fd-sp-5);
}

// ── 文档 API 表格 ──────────────────────────────────────────────────────────
// `:not(.example *)` 是刚需：demo 区里的 `<table>` 是 `<f-table>` 组件本体，
// 站点共 74 个，不能套用文档表格的留白与描边。
.vp-doc table:not(.example *) {
  display: table;
  width: 100%;
  margin: var(--fd-sp-4) 0 var(--fd-sp-5);
  border-collapse: separate;
  border-spacing: 0;
  border-radius: var(--fd-radius-md);
  background: var(--fd-table-bg);
  // 文字色**不能**写 --vs-theme-code：那是组件库的「深色文字色」，
  // 暗色主题下它会被改成近黑（#141417），现在压在白色表格底上没问题，
  // 一旦表格底跟着变暗就会变成黑底黑字。见 custom.styl:104 的同类提醒。
  color: var(--fd-table-text);
  font-size: var(--fd-fs-sm);
  // 长标识符（如 --fei-border-radius-default）在必要时才折行
  overflow-wrap: break-word;
}

// ⚠️ 必须中和 VitePress 默认主题给 <tr> 的两条声明：
//     .vp-doc tr { background-color: var(--vp-c-bg); border-top: 1px solid var(--vp-c-divider) }
//     .vp-doc tr:nth-child(2n) { background-color: var(--vp-c-bg-soft) }
//   1) 那套 token 的**暗色分支挂在 `html.dark` 下**，而本站暗色是自研的
//      `body[vs-theme="dark"]`（见 components/Config.vue）→ `--vp-c-bg` 恒取
//      浅色 #ffffff。行底色画在单元格之下、表格底之上，于是暗色主题下整张
//      表格变成白斑：实测 tr 1.58:1、td 1.23:1，肉眼看是「表格没跟着变暗」。
//   2) `border-top` 与单元格各自的 `border-bottom` 叠加，会在每行之间形成
//      1px 双线（且两个值不同色）。行分隔线统一交给单元格画。
//   行底色交给单元格（斑马纹 / hover / 表格自身的 --fd-table-bg），tr 保持透明。
.vp-doc table:not(.example *) tr,
.vp-doc table:not(.example *) tr:nth-child(2n) {
  background: transparent;
  border-top: 0;
}

.vp-doc table:not(.example *) th,
.vp-doc table:not(.example *) td {
  padding: var(--fd-sp-2) var(--fd-sp-4);
  border: 0;
  border-bottom: 1px solid var(--fd-border);
  text-align: left;
  vertical-align: top;
  line-height: 1.6;
}

.vp-doc table:not(.example *) th {
  background: var(--fd-th-bg);
  border-top: 1px solid var(--fd-border);
  color: var(--fd-text-1);
  font-size: var(--fd-fs-sm);
  font-weight: 600;
  white-space: nowrap;
}

// ⚠️ `td` 必须**显式**声明字号，不能只靠 <table> 上的 font-size 往下继承。
// `font-size` 是**继承属性**：容器上的声明特异性再高，也永远输给「直接命中
// 子元素」的声明。VitePress 默认主题有一条 `.vp-doc td { font-size: 14px }`
// （0,1,1），于是表体一直是 14px、表头才是 token 值，出现「表体比表头大」的
// 倒挂，token 名义上管着表格其实管不到。产物里 56 条 .vp-doc 字号规则，
// 只有 td 这一条漏网。
.vp-doc table:not(.example *) td {
  font-size: var(--fd-fs-sm);
  color: var(--fd-table-text);
}

// 表头首列与末列承担外框 + 圆角（border-collapse: separate 下才生效）
.vp-doc table:not(.example *) th:first-child {
  border-left: 1px solid var(--fd-border);
  border-top-left-radius: var(--fd-radius-md);
}

.vp-doc table:not(.example *) th:last-child {
  border-right: 1px solid var(--fd-border);
  border-top-right-radius: var(--fd-radius-md);
}

.vp-doc table:not(.example *) td:first-child {
  border-left: 1px solid var(--fd-border);
  color: var(--fd-text-1);
  font-weight: 500;
}

.vp-doc table:not(.example *) td:last-child {
  border-right: 1px solid var(--fd-border);
}

// 斑马纹（极淡）与行悬停，替代原来的逐格描边
.vp-doc table:not(.example *) tbody tr:nth-child(2n) td {
  background: var(--fd-tr-stripe);
}

.vp-doc table:not(.example *) tbody tr:hover td {
  background: var(--fd-tr-hover);
}

// 收口：最后一行不画下边框，由容器圆角收尾
.vp-doc table:not(.example *) tbody tr:last-child td {
  border-bottom: 0;
}

.vp-doc table:not(.example *) tbody tr:last-child td:first-child {
  border-bottom-left-radius: var(--fd-radius-md);
}

.vp-doc table:not(.example *) tbody tr:last-child td:last-child {
  border-bottom-right-radius: var(--fd-radius-md);
}

// ── 窄屏 ───────────────────────────────────────────────────────────────────
// 表格在窄屏改为可横向滚动块，避免列被压成竖排单字
@media (max-width: 768px) {
  .vp-doc table:not(.example *) {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }

  .vp-doc table:not(.example *) th,
  .vp-doc table:not(.example *) td {
    white-space: nowrap;
  }
}

@media (max-width: 560px) {
  .vp-doc h1 {
    font-size: 24px;
  }

  .vp-doc h2 {
    font-size: var(--fd-fs-h3);
  }
}
